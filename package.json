  },
  "bugs": {
    "url": "https://github.com/gabrieleligetta/lestapenna/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "test": "jest",
    "docker:up": "bash ./scripts/docker-compose-safe.sh up",
    "docker:down": "bash ./scripts/docker-compose-safe.sh down",
    "docker:restart": "bash ./scripts/docker-compose-safe.sh restart",
    "docker:logs": "bash ./scripts/docker-compose-safe.sh logs",
    "admin:rebuild": "ts-node src/admin/run_rebuild.ts",
    "admin:reassess-npc-history": "ts-node src/admin/reassessExistingNpcHistory.ts",
    "db:init": "ts-node src/scripts/init_db.ts",
    "infra:probe-sqlite": "ts-node src/scripts/sqlite-contention-probe.ts",
    "secrets:generate-key": "ts-node src/scripts/generate_secrets_key.ts",
    "secrets:rotate": "ts-node src/scripts/rotate_secrets.ts",
    "secrets:set": "ts-node src/scripts/set_secret.ts",
    "secrets:import-env": "ts-node src/scripts/import_env_secrets.ts",
    "rag:reindex": "ts-node src/scripts/reindex_embeddings.ts",
    "models:refresh": "ts-node src/scripts/refresh-model-catalog.ts",
    "db:seed-quests": "ts-node src/scripts/seed_quests.ts",
    "db:update-quest-desc": "ts-node src/scripts/update_quest_desc.ts",
    "openapi:generate": "ts-node src/scripts/generate_openapi.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code web/openapi.json",
    "docs:commands": "ts-node src/scripts/generate-commands-doc.ts",
    "reports:sync-index": "ts-node src/scripts/reports-sync-index.ts",
    "reports:list": "ts-node src/scripts/reports-list.ts",
    "reports:download": "ts-node src/scripts/reports-download.ts",
    "reports:close": "ts-node src/scripts/reports-close.ts",
    "inventory:backfill-category": "ts-node src/scripts/inventory-backfill-category.ts",
    "preview:api": "nodemon --watch src --exec ts-node src/scripts/preview_api.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "jest": "^30.4.2",
