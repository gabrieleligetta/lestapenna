DISCORD_BOT_TOKEN=
DISCORD_SUMMARY_CHANNEL_ID=
DISCORD_COMMAND_AND_RESPONSE_CHANNEL_ID=
# DISCORD_DEVELOPER_ID=  # Amministratore di OGNI gilda servita da questa
#                        # istanza. Vuoto = nessuno, ed è il default giusto:
#                        # mettici il tuo ID solo se l'istanza è tua.
# DEV_GUILD_ID=           # Se impostato, il bot risponde solo a questo server (dev locale)
# IGNORE_GUILD_IDS=       # Lista di guild ID da ignorare, separati da virgola

# --- LOGIN DISCORD (webapp, Fase 2.2) ---
# Applicazione Discord separata dal bot (stesso Developer Portal, tab OAuth2):
# serve client_id/client_secret con redirect verso .../api/v1/auth/discord/callback.
# Senza queste due, GET /api/v1/auth/discord risponde 503 invece di crashare il boot.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# PUBLIC_BASE_URL=https://lestapenna.quest
# DISCORD_OAUTH_REDIRECT_URI=       # Default: {PUBLIC_BASE_URL}/api/v1/auth/discord/callback
# SESSION_COOKIE_SECRET=            # Cambiare in produzione (default insicuro solo per dev locale)
# WEB_SESSION_TTL_SECONDS=          # Default: 2592000 (30 giorni)

# --- LINK MOSTRATI DAL BOT ---
# Usati da `$dona`, dal piè di pagina di `$aiuto` e dalla riga che compare a
# inizio/fine sessione. I default puntano al progetto originale: è lo stesso
# link che stanno già in .github/FUNDING.yml e nel README, e `$dona` parla di
# Lestapenna, non di chi lo ospita. REPO_URL deve indicare il repository pubblico
# del codice, mai il repository operativo privato usato per il deploy.
#
# Se fai un fork, mettici i tuoi. Se non vuoi chiedere niente a nessuno,
# svuota DONATION_URL: il link sparisce ovunque, `$dona` compreso.
# DONATION_URL=https://github.com/sponsors/gabrieleligetta
# REPO_URL=https://github.com/gabrieleligetta/lestapenna
#
# Un profilo GitHub Sponsors non ancora pubblicato reindirizza al profilo utente:
# il link si apre e non chiede niente. Finché DONATION_ACTIVE è false la web app
# nomina il sostegno ma non lo rende cliccabile. Mettilo a true quando la pagina
# accetta davvero donazioni.
# DONATION_ACTIVE=false
#
# Il secondo canale, con lo stesso interruttore e per la stessa ragione. Sono
# separati perché sono pronti in momenti diversi: Ko-fi incassa appena Stripe
# approva, GitHub Sponsors aspetta settimane per il profilo fiscale. Un solo
# flag costringerebbe il canale veloce ad aspettare quello lento.
# A URL vuoto il pulsante non compare affatto.
# KOFI_URL=https://ko-fi.com/gabrieleligetta
# KOFI_ACTIVE=true
#
# false = nessun messaggio propone mai la donazione da solo. `$dona` resta,
# per chi lo cerca. Il link alla web app nei riassunti sparisce con esso.
# COMMUNITY_NUDGES=true

# Indirizzo a cui scrivere per privacy e segnalazioni. Compare in `$segnala` e
# nei messaggi che non possono risolvere da soli. Se gestisci un'istanza tua,
# mettici il tuo: il manutentore upstream non può rispondere dei tuoi tavoli.
# CONTACT_EMAIL=

# Dopo quanti giorni l'audio grezzo per-parlante viene cancellato dal bucket,
# a prescindere dallo spazio occupato. Il riassunto e la trascrizione restano:
# se ne va solo la voce, che è il dato più personale che raccogliamo.
# 0 disattiva il passaggio a tempo e lascia solo quello per pressione di spazio.
# RAW_AUDIO_RETENTION_DAYS=30

# Community instance capacity guards. Recording has priority over background
# processing; raise these only after a load test on the production shape.
# MAX_CONCURRENT_RECORDING_GUILDS=2
# MAX_PENDING_SESSIONS_PER_GUILD=2
# MAX_CONCURRENT_UPLOADS=2
# MIX_CONCURRENCY_LIMIT=1
# AUDIO_WORKER_CONCURRENCY=2  # una trascrizione per sessione; fino a due gilde in parallelo
# SESSION_ORCHESTRATION_CONCURRENCY=10
# SQLITE_BUSY_TIMEOUT_MS=10000
# CAPACITY_METRICS_DIR=./data/capacity-metrics  # checkpoint tecnici; cancellati dopo upload del report

# --- CHIAVI AI: NON VANNO QUI ---
# Lestapenna è BYOK e le chiavi AI vivono SOLO nella cassaforte cifrata: ogni
# tavolo configura le proprie dalla web app (o con `npm run secrets:set`) e la
# spesa ricade sul suo account provider. Nessuna gilda legge da qui, e non
# esiste un'istanza che paghi per qualcun altro.
#
# Le variabili qui sotto restano solo per la migrazione una tantum: si
# valorizzano, si esegue `npm run secrets:import-env` per travasarle nella
# cassaforte, e poi SI SVUOTANO. In chiaro su disco finiscono nei backup del
# volume e in `docker inspect`; in cassaforte sono cifrate e revocabili.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=

# Non sono segreti: identificano l'endpoint, non autorizzano nulla.
OPENAI_PROJECT_ID=
OLLAMA_CLOUD_BASE_URL=

# --- CASSAFORTE DEI SEGRETI ---
# Cifra a riposo le chiavi API che i tavoli affidano all'istanza. Genera con:
#   npm run secrets:generate-key
# ⚠️ Custodiscila FUORI da questo progetto e fuori dal bucket della replica
# Litestream: nello stesso backup dei dati che protegge non serve a nulla.
# ⚠️ Senza questa NON funziona nulla che usi l'IA: è l'unica via alle chiavi
# dei tavoli. È anche l'unico segreto che deve per forza stare in ambiente —
# la cassaforte non può custodire la chiave che la apre.
SECRETS_MASTER_KEY=
# Durante una rotazione (vedi npm run secrets:rotate) convivono più versioni:
# SECRETS_MASTER_KEY_V2=
# SECRETS_ACTIVE_KEY_VERSION=2

# --- INFRASTRUTTURA ---
# Configurazione Oracle Object Storage (S3 Compatible)
OCI_REGION=eu-milan-1
OCI_NAMESPACE=iltuonamespace
OCI_BUCKET_NAME=lestapenna-recordings
# Entity images always use a separate private bucket in production.
# Dev may opt into a dedicated local directory with MEDIA_STORAGE_DRIVER=local.
MEDIA_STORAGE_DRIVER=disabled
OCI_MEDIA_BUCKET_NAME=lestapenna-media
MEDIA_LOCAL_DIR=./data/media
OCI_ACCESS_KEY_ID=le_tue_chiavi_customer_secret
OCI_SECRET_ACCESS_KEY=la_tua_secret_key
OCI_ENDPOINT=https://iltuonamespace.compat.objectstorage.eu-milan-1.oraclecloud.com
# Database backup bucket (the janitor's nightly snapshots + the Litestream
# replica). Left empty, the DB backup is simply skipped: there is no default
# because it would be somebody else's bucket.
OCI_DB_BACKUP_BUCKET=

# --- PC DI TRASCRIZIONE: NON VA QUI ---
# Ogni tavolo installa `lesta-penna-ai-server` sul PROPRIO computer e lo
# configura dalla pagina impostazioni: indirizzo, token e accensione remota
# sono per gilda, salvati nel database (il token cifrato in cassaforte).
# Il PC dell'operatore serve al suo tavolo, non a chi usa l'istanza pubblica.
#
# Resta solo per la migrazione una tantum con `npm run secrets:import-env`,
# che va comunque eseguita nominando le gilde una per una:
# REMOTE_WHISPER_AUTH_TOKEN=

# L'accensione remota del PC (Wake-on-LAN, API del router, presa smart…) si
# configura anch'essa dalla pagina impostazioni: il metodo è un'implementazione
# registrata in `src/services/wake/`, e ognuna dichiara i campi che le servono.

# Configurazione Email (Porkbun)
EMAIL_ENABLED=false
SMTP_HOST=smtp.porkbun.com
SMTP_PORT=465
SMTP_USER=la-tua-casella@example.com
SMTP_PASS=tu_password_della_casella_email
SMTP_FROM_NAME=Lestapenna Bot
# Dove arrivano i report che non hanno un destinatario proprio.
# Vuoto = non si spedisce a nessuno.
REPORT_RECIPIENT=
# Le segnalazioni inviate dal pulsante "Segnala" della web app. Non ha default:
# senza, le segnalazioni restano solo sul bucket e nessuno riceve la mail.
# TECHNICAL_REPORT_RECIPIENT=
# Il recap di fine sessione. Accetta più indirizzi separati da virgola.
# SESSION_REPORT_RECIPIENT=

# Redis (default: redis:6379)
# REDIS_HOST=redis
# REDIS_PORT=6379

# --- Caddy domain (reverse proxy) ---
# DOMAIN=api.lestapenna.quest

# --- RUNTIME ---
# Tutte con un default sensato: si toccano solo per spostare qualcosa.
# NODE_ENV=production          # 'production' in prod, altrimenti sviluppo
# DB_PATH=./data/dnd_bot.db    # dove vive il database SQLite
# LOG_LEVEL=info               # debug | info | warn | error
# AI_CONFIG_LOCAL=             # percorso di un ai.config.local.json alternativo

# Nota: la configurazione AI (provider, modelli, concorrenza) è in ai.config.json
# Per override locali, copia ai.config.local.example.json → ai.config.local.json
