# Identificatori delle risorse OCI già esistenti, usati SOLO da import.sh.
# Copiare in import.env (non tracciato) e riempire con i valori della propria
# tenancy: si leggono nella console OCI, nella pagina di ogni risorsa.
#
# Serve solo a chi porta sotto Terraform un'infrastruttura creata a mano.
# Chi parte da zero non ha niente da importare e può ignorare questo file.

# Namespace di Object Storage della tenancy (Tenancy details → Object storage namespace)
OS_NAMESPACE=xxxxxxxxxxxx

# --- Network ---
VCN_OCID=ocid1.vcn.oc1.<region>.xxxxxxxxxxxx
IGW_OCID=ocid1.internetgateway.oc1.<region>.xxxxxxxxxxxx
ROUTE_TABLE_OCID=ocid1.routetable.oc1.<region>.xxxxxxxxxxxx
SECURITY_LIST_OCID=ocid1.securitylist.oc1.<region>.xxxxxxxxxxxx
SUBNET_OCID=ocid1.subnet.oc1.<region>.xxxxxxxxxxxx
NSG_OCID=ocid1.networksecuritygroup.oc1.<region>.xxxxxxxxxxxx

# Identificatori esadecimali delle singole regole del NSG (colonna della console).
# Non sono OCID: sono l'ultimo segmento del percorso di import.
NSG_RULE_EGRESS_ALL=XXXXXX
NSG_RULE_HTTP=XXXXXX
NSG_RULE_HTTPS=XXXXXX

# --- Compute ---
INSTANCE_OCID=ocid1.instance.oc1.<region>.xxxxxxxxxxxx

# --- Object Storage ---
BUCKET_RECORDINGS=lestapenna-recordings
BUCKET_RECORDINGS_TEST=lestapenna-recordings-test
BUCKET_DB_BACKUP=lestapenna-db-backup
