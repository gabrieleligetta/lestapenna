  "name": "lestapenna",
  "version": "1.1.1",
  "main": "index.js",
  "author": "Lestapenna contributors <info@lestapenna.quest>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://lestapenna.quest",
  "repository": {
    "type": "git",
